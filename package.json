{
  "name": "invitelogger-api",
  "version": "1.0.0",
  "description": "invitelogger api",
  "main": "./bin/src/server.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "npm run build && node .",
    "build": "tsc --build && tsc-alias",
    "test": "jest --runInBand",
    "dev": "nodemon",
    "format": "prettier . --check",
    "lint": "eslint .",
    "lint:staged": "lint-staged",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaun14/invitelogger-api.git"
  },
  "keywords": [
    "invitelogger",
    "api"
  ],
  "author": "chaun14",
  "license": "ISC",
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "config",
      "types",
      ".env"
    ],
    "ext": "ts",
    "exec": "npm run build && node .",
    "delay": 2500,
    "env": {
      "NODE_ENV": "development"
    }
  },
  "bugs": {
    "url": "https://github.com/chaun14/invitelogger-api/issues"
  },
  "homepage": "https://github.com/chaun14/invitelogger-api#readme",
  "dependencies": {
    "chalk": "^5.3.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.22.5",
    "reflect-metadata": "^0.2.2",
    "smtp2go-nodejs": "^1.0.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "express-list-endpoints": "^7.1.0",
    "glob": "^10.3.12",
    "husky": "^9.0.11",
    "jest": "^30.4.2",
    "lint-staged": "^15.2.2",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsc-alias": "^1.8.8",
    "typescript": "^5.4.5"
  }
}

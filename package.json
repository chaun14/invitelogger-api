  "license": "ISC",
  "bugs": {
    "url": "https://github.com/chaun14/invitelogger-api/issues"
  },
  "homepage": "https://github.com/chaun14/invitelogger-api#readme",
  "dependencies": {
    "@sendgrid/mail": "^7.7.0",
    "dayjs": "^1.11.0",
    "dotenv": "^10.0.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "mysql": "^2.18.1",
    "reflect-metadata": "^0.1.13",
    "tslib": "^2.3.1",
    "typeorm": "^0.2.45",
    "typescript": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/morgan": "^1.9.3",
    "@types/supertest": "^7.2.0",
    "husky": "^4.2.5",
    "jest": "^30.4.2",
    "nodemon": "^2.0.15",
    "prettier": "^2.2.1",
    "pretty-quick": "^2.0.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.4.0"
